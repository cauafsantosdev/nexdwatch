ENVIRONMENT=production
DEBUG=false
SECRET_KEY=<generate-a-production-secret>

POSTGRES_DB=nexdwatch
POSTGRES_USER=nexdwatch
POSTGRES_PASSWORD=<vps-infra-generated-database-password>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://:<shared-redis-password>@redis:6379/2
TASK_STATE_REDIS_URL=redis://:<shared-redis-password>@redis:6379/3
MAINTENANCE_REDIS_URL=redis://:<shared-redis-password>@redis:6379/4

ARTIFACT_ROOT=/app/data
PROFILE_SYNC_FRESHNESS_SECONDS=900
PROFILE_SYNC_ACTIVE_TTL_SECONDS=600
TASK_RESULT_TTL_SECONDS=86400
PROFILE_SYNC_SOFT_TIME_LIMIT_SECONDS=300
PROFILE_SYNC_HARD_TIME_LIMIT_SECONDS=330
CELERY_BROKER_VISIBILITY_TIMEOUT_SECONDS=21600
MAINTENANCE_LOCK_TTL_SECONDS=21600
MAINTENANCE_SOFT_TIME_LIMIT_SECONDS=18000
MAINTENANCE_HARD_TIME_LIMIT_SECONDS=21000
FILM_QUEUE_BATCH_SIZE=100
NEW_ELIGIBLE_USERS_THRESHOLD=100
NEW_MODEL_FILMS_THRESHOLD=250
MAX_MODEL_AGE_DAYS=180
MODEL_RETENTION_PREVIOUS=2
MODEL_POINTER_CHECK_INTERVAL_SECONDS=30

NEXDWATCH_API_URL=http://api:8000
TMDB_API_READ_TOKEN=
